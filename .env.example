# Comma-separated recipients
NOTIFIER_RECIPIENTS=you@example.com
NOTIFIER_SENDER=you@example.com

# SMTP example: smtp.gmail.com:465 with an app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_USE_SSL=true

# Defaults normally need no changes
DATABASE_PATH=data/earnings.duckdb
TIMEZONE=Europe/Helsinki
NASDAQ_LOOKBACK_DAYS=450
NASDAQ_LOOKAHEAD_DAYS=550

